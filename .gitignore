# Godot 4+ specific ignores
.godot/
/android/
/builds/

# Local cached manual OCR/page extracts generated during rule research.
/manuals/_extracts/
/manuals/

# Antigravity agent & CLI ignores
.antigravity/
.antigravitycli/
*.keystore

# Scratch and temp files
/scratch/
/temp_*

# Godot AI MCP addon: a local editor-only dev tool, not part of the app.
# Scoped to godot_ai so genuine project addons stay trackable.
# NOTE: enabling it in the editor re-adds an autoload + [editor_plugins] block
# to project.godot. Those must NOT be committed - the autoload is a *runtime*
# dependency and breaks CI exports. Run tools/clean_project_settings.ps1 first.
/addons/godot_ai/
/godot-ai-LICENSE.txt
