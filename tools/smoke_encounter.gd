extends "res://tools/test_harness.gd"

func _init() -> void:
	begin_async("encounter and portraits", 1000)
	_run.call_deferred()

func _run() -> void:
	var rules := AlternityRules.new()
	rules.load_core_data()
	var doc := CharacterDoc.new(rules)
	doc.set_hero_name("Sela")
	var img := Image.create(400, 300, false, Image.FORMAT_RGB8)
	img.fill(Color.CORNFLOWER_BLUE)
	var encoded := CharacterPortrait.encode(img)
	check_true(encoded.length() <= CharacterPortrait.MAX_ENCODED, "portrait fits transport bound")
	var decoded := CharacterPortrait.decode(encoded)
	check_eq(decoded.get_size(), Vector2i(256, 256), "portrait is normalized")
	doc.apply([CharacterDoc.META], func(c): c["portrait"] = encoded)
	var restored := CharacterDoc.from_dict(rules, JSON.parse_string(JSON.stringify(doc.to_dict())))
	check_eq(restored.raw().portrait, encoded, "portable portrait survives character JSON")
	var session := CampaignSession.new("Encounter test")
	var p1 := session.add_seat("Player one")
	var p2 := session.add_seat("Player two")
	session.commit_character(p1, CharacterSnapshot.of_doc(doc))
	check_eq(session.public_seats()[0].character_name, "Sela", "public roster uses hero_name")
	check_eq(session.public_seats()[0].portrait, encoded, "public roster carries portrait")
	var client := EnetTransport.new()
	client._handle_as_client({"kind": EnetTransport.MSG_ROSTER, "seats": session.public_seats()})
	check_eq(client.table_seats()[0].character_name, "Sela", "live roster refresh carries committed character name")
	var event := session.append_chat(p1, "Hello")
	check_eq(event.payload.character_name, "Sela", "new logs retain character identity")
	var table := TableSession.new(null, null, null, rules)
	check_true(table.describe(event).begins_with("Sela:"), "player log uses character name")
	var npc := session.add_npc(doc.to_dict())
	session.append_roll(npc, {"total": 5, "check": {"ordinary": 13, "result": {"degree": "Good"}}})
	check_eq(session.visible_events_since(p1, 1).size(), 0, "hidden NPC rolls never enter replay")
	check_eq(session.public_seats().size(), 2, "NPCs do not leak through roster")
	var call := SkillCheck.call_for("Awareness", 1)
	session.queue_called_check(call.to_dict(), p1)
	check_eq(session.pending_checks_for(p1).size(), 1, "target retains called check for reconnect")
	check_eq(session.pending_checks_for(p2).size(), 0, "other player does not receive targeted check")
	var fight := ActionRound.new()
	fight.add_combatant(p1, "Sela", 2)
	fight.add_combatant(npc, "Guard", 2, ActionRound.KIND_NPC)
	check_false(fight.start(), "cannot start before initiative")
	fight.record_check(p1, "Good", 14, 6)
	check_true(fight.place_npc(npc, "good", 11), "GM can place NPC without rolling")
	check_false(fight.place_npc(p1, "amazing", 99), "NPC placement cannot mutate player initiative")
	check_true(fight.start(), "ready encounter can start")
	var public_data := fight.to_public_dict()
	check_false(public_data.combatants[1].has("check_score"), "NPC stat stays off wire")
	var public_fight := ActionRound.from_dict(public_data)
	check_eq(fight.actions_remaining(p1), 2, "initial action budget remaining")
	check_eq(fight.opportunities_remaining(p1), 2, "opportunities remaining in round")
	fight.advance_phase()
	check_true(fight.act(p1), "p1 takes an action in good phase")
	check_eq(fight.actions_remaining(p1), 1, "acting spends an action slot from budget")
	fight.advance_phase()
	check_eq(fight.actions_remaining(p1), 1, "advancing preserves remaining budget")
	check_eq(fight.opportunities_remaining(p1), 1, "remaining phase opportunities capped by budget and phases left")

	var ordering := ActionRound.new()
	ordering.add_combatant("a", "A", 4)
	ordering.add_combatant("b", "B", 4, ActionRound.KIND_NPC)
	ordering.add_combatant("c", "C", 4)
	ordering.record_check("a", "amazing", 10)
	ordering.record_check("b", "good", 14)
	ordering.record_check("c", "good", 14)
	ordering.start()
	ordering.advance_phase()
	check_eq(ordering.acting_now()[2].id, "a", "earlier success degree grants no priority over higher scores")
	check_false(ordering.resolve_tie_before("a", "b"), "GM tie resolution cannot reorder unequal scores")
	check_true(ordering.resolve_tie_before("c", "b"), "GM resolves equal scores in current phase")
	check_eq(ordering.acting_now()[0].id, "c", "GM choice puts C first")
	var ordering_saved := ActionRound.from_dict(JSON.parse_string(JSON.stringify(ordering.to_dict())))
	check_eq(ordering_saved.acting_now()[0].id, "c", "tie decision survives persisted round")
	var ordering_public := ActionRound.from_dict(ordering.to_public_dict())
	check_eq(ordering_public.acting_now()[0].id, "c", "players receive GM tie decision despite hidden NPC score")
	check_false(ordering_public.combatant("b").has("check_score"), "tie resolution does not disclose NPC score")
	check_false(ordering.combatant("c").tie_order.has("ordinary"), "GM decision applies only to current phase")
	check_false(ordering.next_round().combatant("c").has("tie_order"), "next round clears tie decisions")
	session.set_round(fight.to_dict())
	var public_roll := session.append_roll(npc, {"check": {"ordinary": 11, "result": {"degree": "Good", "total": 5}}})
	var visible := session.visible_events_since(p1, int(public_roll.seq) - 1)
	check_eq(visible.size(), 1, "participating NPC roll reaches table")
	check_false(visible[0].payload.check.has("ordinary"), "NPC check target remains private")
	check_eq(visible[0].payload.check.result.total, 5, "settled roll survives public projection")
	check_true(public_roll.payload.check.has("ordinary"), "host retains complete roll evidence")
	fight.knock_out(npc)
	fight.advance_phase()
	var next := fight.next_round()
	check_false(next.awaiting_checks().has(npc), "defeated NPC cannot block next round")
	var picker = preload("res://scenes/ui/routes/encounter_participants_route.tscn").instantiate()
	picker.configure({"participants": [{"id": p1, "name": "Sela", "kind": "player"}, {"id": npc, "name": "Guard", "kind": "npc"}]})
	root.add_child(picker)
	check_true(picker._selected[p1], "players selected initially")
	check_false(picker._selected[npc], "NPCs require explicit reveal")
	picker._selected[p1] = false
	picker._update_confirm()
	check_true(picker._confirm.disabled, "empty selection cannot start combat")
	var step = preload("res://scenes/ui/routes/check_step_route.tscn").instantiate()
	step.configure({"recipients": [{"id": p1, "name": "Sela"}], "check": call.to_dict(), "rules": rules})
	root.add_child(step)
	step._recipient.select(1)
	var answers: Array = []
	step.closed.connect(func(result): answers.append(result))
	step._submit()
	check_eq(answers[0].target_player_id, p1, "recipient UI returns stable player identity")
	picker.queue_free()
	step.queue_free()
	await process_frame
	finish()
